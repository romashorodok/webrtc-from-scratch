  }*alen=base;*pc=pn;*ortp=(uint16_t)(c->rtp+pn);*otwcc=(uint16_t)(c->twcc+pn);return OK;
}

typedef struct {
    PyObject_HEAD
    PyObject *name;
    PyObject *qualname;
    PyObject *module;
    PyObject *doc;
    PyObject *annotations;
    PyObject *signature;
} NativeFunction;

static void native_function_dealloc(PyObject *self) {
    NativeFunction *fn = (NativeFunction *)self;
    Py_XDECREF(fn->name); Py_XDECREF(fn->qualname); Py_XDECREF(fn->module); Py_XDECREF(fn->doc);
    Py_XDECREF(fn->annotations); Py_XDECREF(fn->signature);
    Py_TYPE(self)->tp_free(self);
}
static PyObject *get_name(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->name); }
static PyObject *get_qualname(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->qualname); }
static PyObject *get_module(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->module); }
static PyObject *get_doc(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->doc); }
static PyObject *get_annotations(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->annotations); }
static PyObject *get_signature(PyObject *s, void *c) { (void)c; return Py_NewRef(((NativeFunction *)s)->signature); }
static PyGetSetDef native_getset[] = {
    {"__name__", get_name, NULL, NULL, NULL},
    {"__qualname__", get_qualname, NULL, NULL, NULL},
    {"__module__", get_module, NULL, NULL, NULL},
    {"__doc__", get_doc, NULL, NULL, NULL},
    {"__annotations__", get_annotations, NULL, NULL, NULL},
    {"__signature__", get_signature, NULL, NULL, NULL},
    {NULL, NULL, NULL, NULL, NULL}
};

static int exact_int(PyObject *value, const char *name) {
    if (!PyLong_CheckExact(value)) { PyErr_Format(PyExc_TypeError, "%s must be int", name); return 0; }
    return 1;
}
static int ranged_u64(PyObject *value, const char *name, unsigned long long low,
                      unsigned long long high, unsigned long long *out) {
    unsigned long long result = PyLong_AsUnsignedLongLong(value);
    if (result == (unsigned long long)-1 && PyErr_Occurred()) {
        PyErr_Clear();
        PyErr_Format(PyExc_ValueError, "%s must be in range %llu..%llu", name, low, high);
        return 0;
    }
    if (result < low || result > high) {
        PyErr_Format(PyExc_ValueError, "%s must be in range %llu..%llu", name, low, high);
        return 0;
    }
    *out = result; return 1;
}
static PyObject *core_error(int status) {
    const char *reason = NULL;
    switch (status) {
        case E_EXT: reason = "truncated OBU extension header"; break;
        case E_LEB_TRUNC: reason = "truncated OBU size"; break;
        case E_LEB_32: reason = "OBU size exceeds 32-bit LEB128"; break;
        case E_OBU_SIZE: reason = "declared OBU size exceeds frame"; break;
        default: PyErr_Format(PyExc_RuntimeError, "native packetizer failed with status %d", status); return NULL;
    }
    PyErr_Format(PyExc_ValueError, "malformed AV1 frame: %s", reason); return NULL;
}
static PyObject *packetize_call(PyObject *self, PyObject *args, PyObject *kwargs) {
    (void)self;
    static char *names[] = {"frame", "fragmentation_limit", "timestamp", "ssrc",
                            "current_rtp_sequence", "current_twcc_sequence", NULL};
    PyObject *frame, *limit_o, *timestamp_o, *ssrc_o, *rtp_o, *twcc_o;
    unsigned long long limit, timestamp, ssrc, rtp, twcc;
    Config config; const uint8_t *frame_data; Py_ssize_t frame_size;
    uint8_t *scratch = NULL, *arena = NULL; Span *spans = NULL;
    size_t scratch_size = 0, arena_size = 0, packet_capacity = 0;
    size_t arena_length = 0, packet_count = 0, i; uint16_t out_rtp = 0, out_twcc = 0;
    int status; PyObject *packets = NULL, *result = NULL;
    if (!PyArg_ParseTupleAndKeywords(args, kwargs, "OOOOOO:packetize_av1_frame", names,
                                     &frame, &limit_o, &timestamp_o, &ssrc_o, &rtp_o, &twcc_o)) return NULL;
    if (!PyBytes_CheckExact(frame)) { PyErr_SetString(PyExc_TypeError, "frame must be bytes"); return NULL; }
    if (!exact_int(limit_o, "fragmentation_limit") || !exact_int(timestamp_o, "timestamp") ||
        !exact_int(ssrc_o, "ssrc") || !exact_int(rtp_o, "current_rtp_sequence") ||
        !exact_int(twcc_o, "current_twcc_sequence")) return NULL;
    if (!ranged_u64(limit_o, "fragmentation_limit", 3, 65535, &limit) ||
        !ranged_u64(timestamp_o, "timestamp", 0, 4294967295ULL, &timestamp) ||
        !ranged_u64(ssrc_o, "ssrc", 0, 4294967295ULL, &ssrc) ||
        !ranged_u64(rtp_o, "current_rtp_sequence", 0, 65535, &rtp) ||
        !ranged_u64(twcc_o, "current_twcc_sequence", 0, 65535, &twcc)) return NULL;
    frame_size = PyBytes_GET_SIZE(frame);
    if (frame_size > 16777216) { PyErr_SetString(PyExc_ValueError, "frame must not exceed 16777216 bytes"); return NULL; }
    frame_data = (const uint8_t *)PyBytes_AS_STRING(frame);
    config = (Config){(uint32_t)sizeof(Config), 2, (uint32_t)timestamp, (uint32_t)ssrc,
                      (uint16_t)rtp, (uint16_t)twcc, (uint16_t)limit, 0};
    status = wrtc_kernel_e_scratch_size_v2(&config, frame_data, (size_t)frame_size, &scratch_size);
    if (status != OK) return core_error(status);
    scratch = PyMem_Malloc(scratch_size ? scratch_size : 1);
    if (!scratch) return PyErr_NoMemory();
    status = wrtc_kernel_e_measure_v2(&config, frame_data, (size_t)frame_size, scratch,
                                      scratch_size, &arena_size, &packet_capacity);
    if (status != OK) { core_error(status); goto done; }
    arena = PyMem_Malloc(arena_size ? arena_size : 1);
    spans = PyMem_Malloc(packet_capacity ? packet_capacity * sizeof(Span) : 1);
    if (!arena || !spans) { PyErr_NoMemory(); goto done; }
    status = wrtc_kernel_e_packetize_v2(&config, frame_data, (size_t)frame_size, scratch,
                                        scratch_size, arena, arena_size, spans, packet_capacity,
                                        &arena_length, &packet_count, &out_rtp, &out_twcc);
    if (status != OK) { core_error(status); goto done; }
    packets = PyTuple_New((Py_ssize_t)packet_count); if (!packets) goto done;
    for (i = 0; i < packet_count; i++) {
        PyObject *packet = PyBytes_FromStringAndSize((const char *)(arena + spans[i].offset),
                                                     (Py_ssize_t)spans[i].length);
        if (!packet) goto done;
        PyTuple_SET_ITEM(packets, (Py_ssize_t)i, packet);
    }
    result = Py_BuildValue("NHH", packets, out_rtp, out_twcc); packets = NULL;
done:
    Py_XDECREF(packets); PyMem_Free(spans); PyMem_Free(arena); PyMem_Free(scratch); return result;
}

static PyType_Slot native_slots[] = {
    {Py_tp_dealloc, native_function_dealloc}, {Py_tp_call, packetize_call},
    {Py_tp_getset, native_getset}, {0, NULL}
};
static PyType_Spec native_spec = {
    "WRTC_MODULE_NAME_TOKEN._NativeFunction", sizeof(NativeFunction), 0,
    Py_TPFLAGS_DEFAULT | Py_TPFLAGS_IMMUTABLETYPE, native_slots
};
static struct PyModuleDef module_def = { PyModuleDef_HEAD_INIT, "WRTC_MODULE_NAME_TOKEN", NULL, -1, NULL };

static int add_string(PyObject *module, const char *name, const char *value) {
    PyObject *object = PyUnicode_FromString(value); if (!object) return -1;
    if (PyModule_AddObject(module, name, object) < 0) { Py_DECREF(object); return -1; }
    return 0;
}
#if defined(_WIN32)
__declspec(dllexport)
#else
__attribute__((visibility("default")))
#endif
PyMODINIT_FUNC PyInit_WRTC_MODULE_NAME_TOKEN(void) {
    PyObject *module = NULL, *type = NULL, *callable = NULL, *all = NULL;
    PyObject *registry = NULL, *types = NULL, *proxy_factory = NULL, *proxy = NULL;
    PyObject *namespace = NULL, *signature_function = NULL, *inspect = NULL, *inspect_signature = NULL;
    NativeFunction *fn;
    module = PyModule_Create(&module_def); if (!module) goto error;
    type = PyType_FromSpec(&native_spec); if (!type) goto error;
    callable = PyObject_CallNoArgs(type); if (!callable) goto error;
    fn = (NativeFunction *)callable;
    fn->name = PyUnicode_FromString("packetize_av1_frame");
    fn->qualname = PyUnicode_FromString("packetize_av1_frame");
    fn->module = PyUnicode_FromString("WRTC_MODULE_NAME_TOKEN");
    fn->doc = PyUnicode_FromString("Return complete RTP packets and the committed RTP/TWCC sequences.\n\n``fragmentation_limit`` is the AV1 RTP payload budget, matching the current\nRust payloader's ``mtu`` argument.  Each serialized packet consequently has\n20 additional bytes: twelve bytes of fixed RTP header and eight bytes for\nthe padded transport-wide sequence extension.\n");
    namespace = PyDict_New(); if (!namespace) goto error;
