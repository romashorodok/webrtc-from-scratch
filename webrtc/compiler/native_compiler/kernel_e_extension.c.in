#define OK 0
#define E_NULL 1
#define E_ABI 2
#define E_STRUCT 3
#define E_RESERVED 4
#define E_RANGE 5
#define E_FRAME 6
#define E_MALFORMED 7
#define E_SPANS 8
#define E_ARENA 9
#define E_OVERLAP 10
#define E_OVERFLOW 11
#define E_SCRATCH 12
#define E_EXT 71
#define E_LEB_TRUNC 72
#define E_LEB_32 73
#define E_OBU_SIZE 74
typedef struct { uint32_t struct_size, abi_version, timestamp, ssrc; uint16_t rtp, twcc, limit, reserved; } Config;
typedef struct { size_t offset, length; } Span;
typedef struct { uint8_t header, ext; size_t payload, payload_len, size, header_size; } Obu;
typedef struct { size_t first, count, offset, last, size; } Meta;
_Static_assert(sizeof(Config)==24, "Config ABI");
static uint32_t wrtc_kernel_e_abi_version(void){return 2;}
static uint32_t wrtc_kernel_e_pointer_bits(void){return (uint32_t)(8u*sizeof(void*));}
static uint32_t wrtc_kernel_e_config_size(void){return (uint32_t)sizeof(Config);}
static uint32_t wrtc_kernel_e_span_size(void){return (uint32_t)sizeof(Span);}
static const char *wrtc_kernel_e_source_sha256(void){return "WRTC_SOURCE_HASH_TOKEN";}
static size_t leb_size(size_t v){size_t n=1;while(v>=128){n++;v>>=7;}return n;}
static size_t put_leb(uint8_t *p,size_t v){size_t n=0;while(v>=128){p[n++]=(uint8_t)(128|(v&127));v>>=7;}p[n++]=(uint8_t)v;return n;}
static int scan(const uint8_t*f,size_t n,size_t*out_obus,size_t*out_meta){size_t pos=0,oc=0,mc=0;while(pos<n){uint8_t h=f[pos],ext=(uint8_t)((h&4)!=0),sz=(uint8_t)((h&2)!=0);size_t hs=ext?2:1,pp,end;if(n-pos<hs)return E_EXT;pp=pos+hs;if(sz){uint64_t value=0;size_t i;for(i=0;i<5;i++){uint8_t b;if(pp+i>=n)return E_LEB_TRUNC;b=f[pp+i];if(i==4&&b>15)return E_LEB_32;value|=((uint64_t)(b&127))<<(7*i);if(!(b&128))break;}if(i==5)return E_LEB_32;pp+=i+1;if(value>(uint64_t)(n-pp))return E_OBU_SIZE;end=pp+(size_t)value;}else end=n;{uint8_t type=(uint8_t)((h&120)>>3);if(type!=2&&type!=8&&type!=15){size_t logical=hs+end-pp;if(mc>SIZE_MAX-logical-2)return E_OVERFLOW;oc++;mc+=logical+2;}}pos=end;}*out_obus=oc;*out_meta=mc;return OK;}
static int parse(const uint8_t*f,size_t n,Obu*o,size_t cap,size_t*outn){size_t pos=0,k=0;while(pos<n){uint8_t h=f[pos],ext=(uint8_t)((h&4)!=0),sz=(uint8_t)((h&2)!=0);size_t hs=ext?2:1,pp,end;if(n-pos<hs)return E_EXT;pp=pos+hs;if(sz){uint64_t value=0;size_t i;for(i=0;i<5;i++){uint8_t b;if(pp+i>=n)return E_LEB_TRUNC;b=f[pp+i];if(i==4&&b>15)return E_LEB_32;value|=((uint64_t)(b&127))<<(7*i);if(!(b&128))break;}if(i==5)return E_LEB_32;pp+=i+1;if(value>(uint64_t)(n-pp))return E_OBU_SIZE;end=pp+(size_t)value;}else end=n;{uint8_t type=(uint8_t)((h&120)>>3);if(type!=2&&type!=8&&type!=15){if(k>=cap)return E_SCRATCH;o[k]=(Obu){h,ext?f[pos+1]:0,pp,end-pp,hs+end-pp,hs};k++;}}pos=end;}*outn=k;return OK;}
static size_t extra(const Meta*m){return(m->size==0||m->count>3)?0:leb_size(m->last);}
static size_t maxfrag(size_t r){size_t i=1;if(r<=1)return 0;for(;;i++){if(r<(((size_t)1)<<(7*i))+i)return r-i;}}
static int plan(const Obu*o,size_t on,uint16_t limit,Meta*p,size_t cap,size_t*outn){
  size_t k=0,remaining=(size_t)limit-1,i;if(!on){*outn=0;return OK;}if(!cap)return E_SCRATCH;p[k++]=(Meta){0,0,0,0,0};
  for(i=0;i<on;i++){int lastobu=(i+1==on);Meta m=p[--k];size_t ex=extra(&m),minreq=m.count>=3?2:1,required,first,maxfirst,off,last;
    if(remaining<ex+minreq){if(k>=cap)return E_SCRATCH;p[k++]=m;m=(Meta){i,0,0,0,0};remaining=(size_t)limit-1;ex=0;}m.size+=ex;remaining-=ex;m.count++;required=o[i].size+(m.count>3?leb_size(o[i].size):0);
    if(required<remaining){m.last=o[i].size;m.size+=required;remaining-=required;if(k>=cap)return E_SCRATCH;p[k++]=m;continue;}
    maxfirst=m.count>3?maxfrag(remaining):remaining;first=o[i].size-1<maxfirst?o[i].size-1:maxfirst;if(!first){m.count--;m.size-=ex;}else{m.size+=first+(m.count>3?leb_size(first):0);m.last=first;}if(k>=cap)return E_SCRATCH;p[k++]=m;off=first;
    while(off+(size_t)limit-1<o[i].size){size_t mid=(size_t)limit-1;if(k>=cap)return E_SCRATCH;p[k++]=(Meta){i,1,off,mid,mid};off+=mid;}
    last=o[i].size-off;if(lastobu&&last>(size_t)limit-1){size_t semi=last/2;if(semi>=last)semi=last-1;last-=semi;if(k>=cap)return E_SCRATCH;p[k++]=(Meta){i,1,off,semi,semi};off+=semi;}if(k>=cap)return E_SCRATCH;p[k++]=(Meta){i,1,off,last,last};remaining=(size_t)limit-1-last;
  }*outn=k;return OK;
}
static uint8_t agg(const Obu*o,const Meta*m,size_t pi){uint8_t h=0;size_t lo=m->count==1?m->offset:0;if(m->offset)h|=128;if(lo+m->last<o[m->first+m->count-1].size)h|=64;if(m->count<=3)h|=(uint8_t)(m->count<<4);if(pi==0&&((o[0].header&120)>>3)==1)h|=8;return h;}
static void fragment(uint8_t*out,size_t*at,const uint8_t*f,const Obu*o,size_t off,size_t amount){size_t po;if(off==0&&amount){out[(*at)++]=(uint8_t)(o->header&253);amount--;}if(off<=1&&(o->header&4)&&amount){out[(*at)++]=o->ext;amount--;}po=off>o->header_size?off-o->header_size:0;memcpy(out+*at,f+o->payload+po,amount);*at+=amount;}
static size_t packet_len(const Meta*m){return 21+m->size;}
typedef struct {const void*p;size_t n;} Range;
static int overlaps(const Range*a,const Range*b){uintptr_t x,y;if(!a->n||!b->n)return 0;x=(uintptr_t)a->p;y=(uintptr_t)b->p;return x<=y?(y-x<a->n):(x-y<b->n);}
static int any_overlap(const Range*r,size_t n){size_t i,j;for(i=0;i<n;i++)for(j=i+1;j<n;j++)if(overlaps(&r[i],&r[j]))return 1;return 0;}
static int valid(const Config*c,const uint8_t*f,size_t fn){if(!c)return E_NULL;if(c->abi_version!=2)return E_ABI;if(c->struct_size!=sizeof(Config))return E_STRUCT;if(c->reserved)return E_RESERVED;if(fn&&!f)return E_NULL;if(c->limit<3||fn>16777216)return fn>16777216?E_FRAME:E_RANGE;return OK;}
static int scratch_layout(const uint8_t*f,size_t fn,size_t*need,size_t*oc,size_t*mc,size_t*meta_offset){size_t a=_Alignof(Meta),off,total;int st=scan(f,fn,oc,mc);if(st)return st;if(*oc>SIZE_MAX/sizeof(Obu))return E_OVERFLOW;off=*oc*sizeof(Obu);if(off>SIZE_MAX-(a-1))return E_OVERFLOW;off=(off+a-1)/a*a;if(*mc>SIZE_MAX/sizeof(Meta)||off>SIZE_MAX-*mc*sizeof(Meta))return E_OVERFLOW;total=off+*mc*sizeof(Meta);*need=total;*meta_offset=off;return OK;}
static int32_t wrtc_kernel_e_scratch_size_v2(const Config*c,const uint8_t*f,size_t fn,size_t*out){size_t oc=0,mc=0,mo=0,body=0,a=_Alignof(Obu);int st;if(!out)return E_NULL;*out=0;st=valid(c,f,fn);if(st)return st;if(overlaps(&(Range){c,sizeof(*c)},&(Range){out,sizeof(*out)})||overlaps(&(Range){f,fn},&(Range){out,sizeof(*out)}))return E_OVERLAP;st=scratch_layout(f,fn,&body,&oc,&mc,&mo);if(st)return st;if(body>SIZE_MAX-(a-1))return E_OVERFLOW;*out=body+a-1;return OK;}
static int prepare(const Config*c,const uint8_t*f,size_t fn,uint8_t*scratch,size_t scratch_cap,Obu**o,size_t*on,Meta**p,size_t*pn){size_t body=0,oc=0,mc=0,mo=0,a=_Alignof(Obu),prefix=0;uintptr_t raw,aligned;int st=scratch_layout(f,fn,&body,&oc,&mc,&mo);if(st)return st;if(body==0){*o=NULL;*p=NULL;*on=*pn=0;return OK;}if(!scratch)return E_SCRATCH;raw=(uintptr_t)scratch;aligned=raw+(a-raw%a)%a;prefix=(size_t)(aligned-raw);if(prefix>scratch_cap||body>scratch_cap-prefix)return E_SCRATCH;*o=(Obu*)aligned;*p=(Meta*)((uint8_t*)*o+mo);st=parse(f,fn,*o,oc,on);if(st)return st;return plan(*o,*on,c->limit,*p,mc,pn);}
static int32_t wrtc_kernel_e_measure_v2(const Config*c,const uint8_t*f,size_t fn,uint8_t*scratch,size_t scratch_cap,size_t*arena,size_t*packets){Obu*o=NULL;Meta*p=NULL;size_t on=0,pn=0,total=0,i;int st;Range ranges[5];if(!arena||!packets)return E_NULL;*arena=*packets=0;st=valid(c,f,fn);if(st)return st;if(scratch_cap&&!scratch)return E_NULL;ranges[0]=(Range){c,sizeof(*c)};ranges[1]=(Range){f,fn};ranges[2]=(Range){scratch,scratch_cap};ranges[3]=(Range){arena,sizeof(*arena)};ranges[4]=(Range){packets,sizeof(*packets)};if(any_overlap(ranges,5))return E_OVERLAP;st=prepare(c,f,fn,scratch,scratch_cap,&o,&on,&p,&pn);if(st)return st;for(i=0;i<pn;i++){size_t q=packet_len(&p[i]);if(q>SIZE_MAX-total)return E_OVERFLOW;total+=q;}*arena=total;*packets=pn;return OK;}
static int32_t wrtc_kernel_e_packetize_v2(const Config*c,const uint8_t*f,size_t fn,uint8_t*scratch,size_t scratch_cap,uint8_t*a,size_t ac,Span*s,size_t sc,size_t*alen,size_t*pc,uint16_t*ortp,uint16_t*otwcc){
  Obu*o=NULL;Meta*p=NULL;size_t on=0,pn=0,total=0,i,base=0,span_bytes;int st;Range ranges[10];if(!alen||!pc||!ortp||!otwcc)return E_NULL;*alen=*pc=0;*ortp=*otwcc=0;st=valid(c,f,fn);if(st)return st;if((scratch_cap&&!scratch)||(ac&&!a)||(sc&&!s))return E_NULL;if(sc>SIZE_MAX/sizeof(Span))return E_OVERFLOW;span_bytes=sc*sizeof(Span);ranges[0]=(Range){c,sizeof(*c)};ranges[1]=(Range){f,fn};ranges[2]=(Range){scratch,scratch_cap};ranges[3]=(Range){a,ac};ranges[4]=(Range){s,span_bytes};ranges[5]=(Range){alen,sizeof(*alen)};ranges[6]=(Range){pc,sizeof(*pc)};ranges[7]=(Range){ortp,sizeof(*ortp)};ranges[8]=(Range){otwcc,sizeof(*otwcc)};ranges[9]=(Range){NULL,0};if(any_overlap(ranges,9))return E_OVERLAP;st=prepare(c,f,fn,scratch,scratch_cap,&o,&on,&p,&pn);if(st)return st;if(pn>sc)return E_SPANS;for(i=0;i<pn;i++){size_t q=packet_len(&p[i]);if(q>SIZE_MAX-total)return E_OVERFLOW;total+=q;}if(total>ac)return E_ARENA;
  for(i=0;i<pn;i++){Meta*m=&p[i];size_t at=base,j,off=m->offset;uint16_t rs=(uint16_t)(c->rtp+i+1),ts=(uint16_t)(c->twcc+i+1);a[at++]=144;a[at++]=(uint8_t)(45|(i+1==pn?128:0));a[at++]=(uint8_t)(rs>>8);a[at++]=(uint8_t)rs;a[at++]=(uint8_t)(c->timestamp>>24);a[at++]=(uint8_t)(c->timestamp>>16);a[at++]=(uint8_t)(c->timestamp>>8);a[at++]=(uint8_t)c->timestamp;a[at++]=(uint8_t)(c->ssrc>>24);a[at++]=(uint8_t)(c->ssrc>>16);a[at++]=(uint8_t)(c->ssrc>>8);a[at++]=(uint8_t)c->ssrc;a[at++]=190;a[at++]=222;a[at++]=0;a[at++]=1;a[at++]=65;a[at++]=(uint8_t)(ts>>8);a[at++]=(uint8_t)ts;a[at++]=0;a[at++]=agg(o,m,i);
