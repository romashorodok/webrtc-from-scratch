    if (!PyRun_String("def _pymeta_signature(frame: bytes, fragmentation_limit: int, timestamp: int, ssrc: int, current_rtp_sequence: int, current_twcc_sequence: int) -> tuple[tuple[bytes, ...], int, int]:\n    pass\n", Py_file_input, namespace, namespace)) goto error;
    signature_function = PyDict_GetItemString(namespace, "_pymeta_signature");
    if (!signature_function) goto error;
    fn->annotations = PyDict_Copy(PyFunction_GetAnnotations(signature_function));
    inspect = PyImport_ImportModule("inspect"); if (!inspect) goto error;
    inspect_signature = PyObject_GetAttrString(inspect, "signature"); if (!inspect_signature) goto error;
    fn->signature = PyObject_CallOneArg(inspect_signature, signature_function);
    if (!fn->name || !fn->qualname || !fn->module || !fn->doc || !fn->annotations || !fn->signature) goto error;
    if (PyModule_AddObjectRef(module, "packetize_av1_frame", callable) < 0) goto error;
    all = Py_BuildValue("[s]", "packetize_av1_frame"); if (!all) goto error;
    if (PyModule_AddObjectRef(module, "__all__", all) < 0) goto error;
    registry = PyDict_New(); if (!registry) goto error;
    if (PyDict_SetItemString(registry, "packetize_av1_frame", callable) < 0) goto error;
    types = PyImport_ImportModule("types"); if (!types) goto error;
    proxy_factory = PyObject_GetAttrString(types, "MappingProxyType"); if (!proxy_factory) goto error;
    proxy = PyObject_CallOneArg(proxy_factory, registry); if (!proxy) goto error;
    if (PyModule_AddObjectRef(module, "__pymeta_functions__", proxy) < 0) goto error;
    if (PyModule_AddIntConstant(module, "_MAX_FRAME_SIZE", 16777216) < 0 ||
        PyModule_AddIntConstant(module, "_MAX_NUM_OBUS_TO_OMIT_SIZE", 3) < 0) goto error;
    {
        PyObject *ignored = Py_BuildValue("(iii)", 2, 8, 15);
        if (!ignored) goto error;
        if (PyModule_AddObject(module, "_IGNORED_OBU_TYPES", ignored) < 0) {
            Py_DECREF(ignored); goto error;
        }
    }
    if (add_string(module, "__pymeta_source_sha256__", "WRTC_SOURCE_HASH_TOKEN") < 0 ||
        add_string(module, "__pymeta_semantic_sha256__", "WRTC_SEMANTIC_HASH_TOKEN") < 0 ||
        add_string(module, "__pymeta_compiler_version__", "WRTC_COMPILER_TOKEN") < 0 ||
        add_string(module, "__pymeta_cpython_revision__", "WRTC_CPYTHON_TOKEN") < 0 ||
        add_string(module, "__pymeta_target__", "WRTC_TARGET_TOKEN") < 0 ||
        add_string(module, "__pymeta_architecture__", "WRTC_ARCH_TOKEN") < 0 ||
        add_string(module, "__pymeta_optimization__", "WRTC_OPT_TOKEN") < 0) goto error;
    Py_DECREF(type); Py_DECREF(callable); Py_DECREF(all); Py_DECREF(registry); Py_DECREF(types);
    Py_DECREF(proxy_factory); Py_DECREF(proxy); Py_DECREF(namespace); Py_DECREF(inspect);
    Py_DECREF(inspect_signature); return module;
error:
    Py_XDECREF(type); Py_XDECREF(callable); Py_XDECREF(all); Py_XDECREF(registry); Py_XDECREF(types);
    Py_XDECREF(proxy_factory); Py_XDECREF(proxy); Py_XDECREF(namespace); Py_XDECREF(inspect);
    Py_XDECREF(inspect_signature); Py_XDECREF(module); return NULL;
}
